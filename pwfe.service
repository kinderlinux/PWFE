[Unit]
Description=Panda Web File Explorer (PWFE)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pwfe
ExecStart=/opt/pwfe/pwfe
Environment=PWFE_ROOT=/opt/pwfe
Environment=PWFE_CONFIG=/etc/pwfe/config.json
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
